  "behavioral_requirements": [
    "Draft content is never accessible publicly.",
    "Scheduled content is published atomically upon reaching publication timestamp.",
    "Merchant A cannot access or mutate Merchant B's content under any route or payload.",
    "Stale revision saves are rejected with conflict error.",
    "Revision rollback creates forward revisions preserving full history.",
    "Builder AST preserves responsive overrides and collection self-exclusion."
  ],
  "forbidden_behaviors": [
    "Returning draft content to unauthenticated shoppers.",
    "Allowing client-supplied merchant_id to override authenticated session context.",
    "Silent overwrite of newer revisions during concurrent edits.",
    "Truncating or erasing historical revisions upon restore.",
    "Bypassing RLS policies or staff role restrictions."
  ],
  "protected_existing_contracts": [
    "DIE-001-responsive-precedence",
    "DIE-002-collection-composition"
  ],
  "state_machine_owner": "src/lib/editor/editor.server.ts",
  "security": {
    "tenant_boundary": "PostgreSQL Row-Level Security on storefront_pages, articles, revisions via is_merchant_member(merchant_id)",
    "roles_scopes": [
      "marketing.read",
      "marketing.update",
      "marketing.publish",
      "marketing.create"
    ],
    "threat_model": "Multi-tenant isolation, cross-tenant traversal, IDOR, forged tenant headers, unauthorized publication, concurrent race conditions."
  },
  "verification": {
    "static": ["gate:scope", "gate:drift", "typecheck", "lint"],
    "unit_component": ["src/lib/cms-lifecycle.test.ts", "src/components/builder/builder-ast-conformance.test.ts"],
    "contract_integration": ["src/lib/cms-tenant-rls.test.ts"],
    "properties": ["src/lib/cms-properties.test.ts"],
