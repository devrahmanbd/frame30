    "formal_tla": ["specs/tla/CmsContentLifecycle.tla"],
    "mutation_cases": ["scripts/mutation-test.mjs"],
    "regression_dies": ["DIE-001-responsive-precedence", "DIE-002-collection-composition"]
  },
