  "required_invariants": [
    "Responsive override reset deterministically restores parent device cascade value",
    "Responsive device override never leaks or mutates unrelated breakpoint configurations",
    "Active collection self-exclusion suppresses duplicate collection rails on /c/sarees and /c/festive",
    "Deliberate cross-sells (/c/girls -> More Children's Wear) are strictly preserved across preview and production",
    "Storefront CollectionView and ThemePreviewFrame share identical section composition semantics"
  ],
  "required_acceptance": [
    "Test 2.3 clicks real Reset button via Playwright and asserts override removal and cascade restoration",
    "Test 4.1 asserts real interactive SectionInspector device checkboxes and hide-everywhere warning",
    "A3 authenticated workflow fails closed if merchant credentials are missing (zero silent skips)",
    "A4 browser exploration passes across all 8 viewports (320px to 1440px) with zero horizontal overflow",
    "Property suite passes 6 collection composition properties across 550+ fast-check executions"
  ],
  "required_formal_verification": {
    "bend": {
      "laws": "specs/bend/LAWS.bend",
      "proof": "specs/bend/PROOF.bend",
      "command": "node scripts/bend-verify.mjs"
    },
    "lean": {
      "theorems": ["Pricing.lean", "ThemeLifecycle.lean", "Responsive.lean", "CollectionComposition.lean"],
      "command": "bun run test:lean"
    },
    "tla": {
      "models": ["CheckoutInventory.tla", "ThemeLifecycle.tla", "ResponsiveAutosave.tla"],
      "command": "bun run test:tla"
    }
  },
  "required_ui_properties": [
    "scrollWidth <= innerWidth across all 8 viewports",
    "Zero uncaught JavaScript exceptions",
    "Zero 5xx HTTP response codes",
    "Zero duplicate product cards in active collection merchandising"
  ],
  "required_browser_workflows": [
    "A3: Authenticated merchant builder reset flow",
    "A4: 8-viewport responsive layout conformance"
  ],
  "required_regression_suites": [
    "test:features",
    "test:properties",
    "test:responsive",
    "test:theme-compliance",
    "songoskriti-preview-compositions.test.tsx"
