[Unit]
Description=Fortress nightly whole-system backup (framique)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/frame28
Environment=BACKUP_DIR=/var/backups/framique
# NOTE: rehearsal gate runs inline (mandatory, fail-closed). Scratch-stack dry
# run 6s; weekly live RTO 3-22s (rehearsals.jsonl). A rehearsal failure fails
# the backup (exit 1) before off-site mirror/rotation — uncertified sets never
# ship. BackupCertifiedStale pages if no certified set lands within 24h.
ExecStart=/opt/frame28/ops/backup/backup.sh --label=nightly
