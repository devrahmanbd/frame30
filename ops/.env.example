# Framique — self-hosted ops environment. Copy to ops/.env (git-ignored).
# Secrets that are read from *files* live in ops/secrets/ (see ops/README.md).

# ---- deployment identity -------------------------------------------------
DEPLOY_ENV=production
HOSTNAME=bd-primary-1

# ---- external URLs (used for links in alerts and Grafana) ----------------
PROMETHEUS_EXTERNAL_URL=https://prometheus.internal.framique.com
ALERTMANAGER_EXTERNAL_URL=https://alerts.internal.framique.com
GRAFANA_EXTERNAL_URL=https://grafana.internal.framique.com
GRAFANA_ADMIN_USER=admin

# ---- self-hosted error tracking (ops/docker-compose.errors.yml) ----------
# GlitchTip is the default backend; self-hosted Sentry is the heavy option.
# Run one, both, or neither — with no DSN the app only logs.
GLITCHTIP_DSN=
GLITCHTIP_DOMAIN=https://errors.internal.framique.com
GLITCHTIP_DB_PASSWORD=change-me
GLITCHTIP_SECRET_KEY=change-me
SENTRY_DSN=
SENTRY_WEB_URL=https://sentry.internal.framique.com
SENTRY_DB_PASSWORD=change-me
SENTRY_SECRET_KEY=change-me
SENTRY_ORG=framique
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
# Release/commit tagging and source-map upload identity.
ERROR_RELEASE=
ERROR_COMMIT_SHA=
# Sampling, quota and retention — a bad deploy must not fill the disk.
ERROR_SAMPLE_RATE=1
ERROR_QUOTA_PER_MINUTE=60
ERROR_RETENTION_DAYS=30
# Shared secret for the GlitchTip/Sentry -> Alertmanager webhook bridge.
ERROR_ALERT_SECRET=change-me
ALERTMANAGER_URL=http://alertmanager:9093

# ---- self-hosted Redis ---------------------------------------------------
REDIS_PASSWORD=change-me
REDIS_MAXMEMORY=1gb
# What the *application* reads. Redis is an accelerator: the rate limiter falls
# back to public.rate_limit_hit and the cache falls back to the loader when this
# is unset or unreachable, so a Redis outage degrades throughput, never
# correctness. Use rediss:// when it is not on a private network.
REDIS_URL=redis://default:change-me@redis:6379/0
# Key namespace, so a shared Redis can host preview and production side by side.
REDIS_PREFIX=fq

# ---- scheduled jobs (ops/docker-compose.cron.yml) ------------------------
# Internal address of the app worker on the framique network — cron never goes
# out through the public edge.
APP_INTERNAL_URL=http://app:3000
# Bearer secret compared in constant time by src/lib/cron-auth.server.ts.
BILLING_CRON_SECRET=change-me
# Bearer token for /api/public/metrics. Unset means that endpoint 404s.
METRICS_TOKEN=change-me

# ---- self-hosted Supabase Postgres (read-only monitoring role) -----------
# CREATE ROLE metrics LOGIN PASSWORD '...' IN ROLE pg_monitor;
POSTGRES_EXPORTER_DSN=postgresql://metrics:change-me@supabase-db:5432/postgres?sslmode=disable

# ---- backups (ops/backup/*.sh) -------------------------------------------
# Local backup set root; rotated after BACKUP_RETAIN_DAYS. Off-site copies at
# OBJECT_STORE_TARGET (an rclone remote) are never rotated by the script.
BACKUP_DIR=/var/backups/framique
BACKUP_RETAIN_DAYS=14
OBJECT_STORE_TARGET=

# ---- error tracking mail (ops/docker-compose.errors.yml) -----------------
# GlitchTip needs an outbound mailer for invites and alert digests. The default
# consolemail:// only prints to the container log, which is fine for a staging
# box and wrong for production — point it at the same SMTP account as auth.
GLITCHTIP_EMAIL_URL=consolemail://
GLITCHTIP_FROM_EMAIL=errors@framique.local

# ---- blue/green topology & OpenResty edge (ops/docker-compose.blue-green.yml) -
BLUE_IMAGE=framique:blue
BLUE_SHA=unknown
GREEN_IMAGE=framique:green
GREEN_SHA=unknown
EDGE_ROUTER_IMAGE=openresty/openresty:1.25.3.1-alpine
ACME_ACCOUNT_EMAIL=ops@framique.com
ACME_STAGING=false
DOMAIN_EDGE_TOKEN=change-me
SUPABASE_URL=http://supabase-kong:8000
SUPABASE_ANON_KEY=change-me
SUPABASE_SERVICE_ROLE_KEY=change-me
