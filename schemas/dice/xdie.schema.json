{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://framique.com/schemas/xdie.schema.json",
  "title": "ExecutableVerificationDie",
  "type": "object",
  "required": [
    "schema_version",
    "xdie_id",
    "die_ref",
    "domain",
    "risk_class",
    "obligations"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.3.0"
    },
    "xdie_id": {
      "type": "string",
      "pattern": "^XDIE-[A-Z0-9]+-[A-Z0-9_]+-v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "die_ref": {
      "type": "string",
      "pattern": "^DIE-[0-9]{3}-[a-z0-9-]+$"
    },
    "domain": {
      "type": "string",
      "enum": [
        "theme",
        "builder",
        "cms",
        "storefront",
        "inventory",
        "auth",
        "system"
      ]
    },
    "risk_class": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "standard"
      ]
    },
    "obligations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://framique.com/schemas/obl.schema.json"
      }
    }
  },
  "additionalProperties": false
}
