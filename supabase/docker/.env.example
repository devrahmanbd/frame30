# Framique — self-hosted Supabase environment. Copy to supabase/docker/.env
# (git-ignored) and fill every value. Nothing here has a usable default.
#
# Generate secrets with:
#   openssl rand -hex 32          # JWT_SECRET, REALTIME_ENC_KEY (32 chars), etc.
#   bun run scripts/…             # ANON_KEY / SERVICE_ROLE_KEY are JWTs signed
#                                 # with JWT_SECRET; mint them with the upstream
#                                 # supabase key generator, never by hand.

# ---- Postgres ------------------------------------------------------------
POSTGRES_DB=postgres
POSTGRES_PASSWORD=
POSTGRES_MAX_CONNECTIONS=200
POSTGRES_LOG_MIN_DURATION_MS=500

# ---- JWT / API keys ------------------------------------------------------
# JWT_SECRET must be at least 32 characters. Rotating it invalidates every
# session and both API keys; do it only with a planned sign-out.
JWT_SECRET=
JWT_EXPIRY=3600
ANON_KEY=
SERVICE_ROLE_KEY=

# ---- Public URLs ---------------------------------------------------------
# SUPABASE_PUBLIC_URL is where Kong is reachable from a browser (TLS terminated
# by the edge proxy). SITE_URL is the app itself — auth emails link back to it.
SUPABASE_PUBLIC_URL=https://api.framique.com
SITE_URL=https://framique.com
ADDITIONAL_REDIRECT_URLS=https://framique.com/auth/callback

# ---- Auth ---------------------------------------------------------------
# Anonymous sign-ups and auto-confirm stay off in the compose file itself; these
# are the knobs that remain a deployment decision.
DISABLE_SIGNUP=false
GOTRUE_LOG_LEVEL=info
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

# ---- Mail (transactional auth mail only) --------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=Framique

# ---- Realtime -----------------------------------------------------------
REALTIME_ENC_KEY=
REALTIME_SECRET_KEY_BASE=

# ---- Storage ------------------------------------------------------------
STORAGE_FILE_SIZE_LIMIT=52428800

# ---- PostgREST ----------------------------------------------------------
PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_POOL=20
