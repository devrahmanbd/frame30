[
  {
    "id": "tv-legacy-migrate",
    "description": "Legacy 0.9.0 AST with string media URL promoted to canonical 1.0.0 with default focal point and alt",
    "input": {
      "schemaVersion": "0.9.0",
      "templates": {
        "index": {
          "sections": [
            {
              "type": "craft_story",
              "settings": {
                "imageUrl": "https://cdn.framique.com/artisan.jpg"
              }
            }
          ]
        }
      }
    },
    "expected": {
      "status": "ok",
      "schema": "1.0.0",
      "isStructured": true,
      "url": "https://cdn.framique.com/artisan.jpg",
      "alt": "",
      "focalX": 0,
      "focalY": 0,
      "publishEligible": true
    }
  },
  {
    "id": "tv-canonical-preserve",
    "description": "Canonical 1.0.0 AST with pre-existing structured media preserved without mutation",
    "input": {
      "schemaVersion": "1.0.0",
      "templates": {
        "index": {
          "sections": [
            {
              "type": "craft_story",
              "settings": {
                "imageUrl": {
                  "url": "https://cdn.framique.com/artisan.jpg",
                  "alt": "Handloom",
                  "focalPoint": {
                    "x": 25,
                    "y": 75
                  }
                }
              }
            }
          ]
        }
      }
    },
    "expected": {
      "status": "ok",
      "schema": "1.0.0",
      "isStructured": true,
      "url": "https://cdn.framique.com/artisan.jpg",
      "alt": "Handloom",
      "focalX": 25,
      "focalY": 75,
      "publishEligible": true
    }
  },
