      "^src/lib/dice/[a-zA-Z0-9_.-]+\\.test\\.ts$"
    ],
    "timeout_ms": 60000,
    "env_allowlist": [
      "PATH",
      "NODE_ENV"
    ],
    "sandboxed": true
  },
