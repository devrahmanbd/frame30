[
  {
    "schema_version": "2.3.0",
    "profile_id": "PROF-SCRIPT-v1",
    "adapter": "script",
    "command_template": "node",
    "allowed_cli_args": [
      "^scripts/[a-zA-Z0-9_-]+\\.mjs$",
      "^--contract=features/contracts/[a-zA-Z0-9_.-]+\\.json$",
      "^--[a-zA-Z0-9_-]+(=.*)?$"
    ],
    "timeout_ms": 60000,
    "env_allowlist": [
      "PATH",
      "NODE_ENV",
      "ACTIVE_CHANGE_CONTRACT"
    ],
    "sandboxed": true
  },
  {
    "schema_version": "2.3.0",
    "profile_id": "PROF-VITEST-v1",
    "adapter": "vitest",
    "command_template": "bunx vitest run",
