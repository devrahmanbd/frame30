    "selfhost:preflight": "node scripts/selfhost-preflight.mjs",
    "selfhost:preflight:host": "node scripts/selfhost-preflight.mjs --host --verbose",
    "gates": "bun run typecheck && bun run test && bun run test:contracts && bun run schema:check && bun run cron:check && bun run secrets:scan && bun run selfhost:preflight && bun run gates:release",
    "load:drive": "node scripts/load-drive.mjs",
    "load:suite": "node scripts/load-suite.mjs",
    "responsive:sweep": "node scripts/responsive-sweep.mjs",
    "console:gate": "node scripts/console-gate.mjs",
    "rhythm:gate": "bun scripts/rhythm-gate.mjs",
    "motion:gate": "bun scripts/motion-gate.mjs",
    "asset:gate": "bun scripts/asset-gate.mjs",
    "design:gate": "bun scripts/design-gate.mjs",
    "assets:icons": "bun scripts/build-icon-sprite.mjs",
    "assets:og": "bun scripts/build-og-images.mjs",
    "assets:stills": "bun scripts/capture-ui-stills.mjs",
    "assets:build": "bun run assets:icons && bun run assets:og && bun run assets:stills",
    "e2e:browsers": "node scripts/browser-smoke.mjs",
    "test:contracts": "node scripts/contract-gate.mjs",
    "contracts:verify": "node scripts/contract-gate.mjs --verify",
    "e2e:golden": "playwright test -c .e2e/playwright.config.ts golden_cms_loop",
    "synthetic:trade": "node scripts/synthetic-trading.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:migrate:check": "node scripts/db-migrate.mjs --check",
    "db:backup": "ops/backup/backup.sh",
    "db:rehearse": "ops/backup/rehearse.sh",
    "obs:verify": "node scripts/observability-verify.mjs",
    "obs:verify:alert": "node scripts/observability-verify.mjs --test-alert",
    "err:verify": "node scripts/error-tracking-verify.mjs",
    "err:verify:send": "node scripts/error-tracking-verify.mjs --send"
