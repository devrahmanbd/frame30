{
  "id": "starter-hello",
  "name": "Starter Hello",
  "version": "1.0.0",
  "description": "Minimal third-party plugin: one greeting widget plus one signed server hook.",
  "api": "^3.0.0",
  "permissions": ["read_shop", "read_orders", "render_storefront"],
  "widgets": [
    {
      "key": "greeting",
      "label": "Hello greeting",
      "slots": ["main"],
      "entry": "var box=document.createElement(\"div\");box.textContent=\"Hello from the starter plugin.\";framique.mount(box);",
      "height": 160,
      "propsSchema": [
        {
          "key": "heading",
          "label": "Greeting text",
          "kind": "text",
          "max": 120,
          "default": "Hello from the starter plugin."
        },
        {
          "key": "tone",
          "label": "Tone",
          "kind": "select",
          "options": [
            { "value": "plain", "label": "Plain" },
            { "value": "warm", "label": "Warm" }
          ],
          "default": "plain"
        },
        {
          "key": "show_note",
          "label": "Show note",
          "kind": "boolean",
          "default": false
        }
      ],
      "defaultProps": {
        "heading": "Hello from the starter plugin.",
        "tone": "plain",
        "show_note": false
      },
      "themeable": {
        "version": 1,
        "schema": "greeting:v1",
        "states": ["ready"]
      }
    }
  ],
  "hooks": ["order.created"],
  "hooksUrl": "https://example.com/framique-hooks",
  "settings": [
    {
      "key": "greeting",
      "label": "Greeting",
      "kind": "text",
      "default": "Hello"
    }
  ],
  "i18n": {
    "en": { "greeting": "Greeting" },
    "bn": { "greeting": "শুভেচ্ছা" }
  },
  "budget": { "jsKb": 40, "mainThreadMs": 15 }
}
